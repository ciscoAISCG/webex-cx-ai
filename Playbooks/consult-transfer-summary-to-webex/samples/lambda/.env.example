# Regional Webex Contact Center API base URL.
WXCC_API_BASE_URL=https://api.wxcc-us1.cisco.com

# POC only: one token is reused for Agent Summaries, Calling Numbers and Messaging.
# Never commit the real token.
WEBEX_ACCESS_TOKEN=replace-me

# Optional fallback when comciscocorgid is not included in the webhook.
WEBEX_ORG_ID=

# Number of trailing digits that form an internal extension.
# For example, with length 4, 011005 becomes extension 1005.
EXTENSION_LENGTH=4

# Keep true until transfer-recipient resolution has been verified.
DRY_RUN=true

# Requested for this POC. The body can contain customer information.
LOG_WEBHOOK_BODY=true
